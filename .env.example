# SrcChat Environment Configuration

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/srcchat
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/srcchat

# Ingestion Limits
MAX_REPO_SIZE_MB=100
MAX_REPO_FILES=3000
MAX_INDEXED_LOC=200000
MAX_FILE_SIZE_KB=300
MAX_REPOS_PER_WORKSPACE=10
MAX_CONCURRENT_INDEXING_JOBS=2
CLONE_TIMEOUT_SECONDS=120

# LLM Provider: openai, anthropic, gemini, ollama, or dummy
LLM_PROVIDER=dummy
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=

# Embedding Provider: openai, gemini, or dummy
EMBEDDING_PROVIDER=dummy
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64
